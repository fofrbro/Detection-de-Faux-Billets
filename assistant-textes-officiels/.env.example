# Copier ce fichier en .env puis renseigner les valeurs.
# Aucun secret ne doit être commité.

# --- Base de données (docker-compose.yml) ---
POSTGRES_USER=assistant
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=assistant
POSTGRES_PORT=5433
DATABASE_URL=postgresql://assistant:changez-moi@localhost:5433/assistant

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- LLM (API Anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=1500

# --- Ingestion ---
# User-agent identifiable, avec un moyen de contact.
SCRAPER_USER_AGENT=AssistantTextesOfficielsSN/0.1 (+mailto:contact@example.org)
SCRAPER_MIN_DELAY_SECONDS=2.0
CACHE_DIR=data/cache

# --- Recherche ---
SEARCH_TOP_K=5
